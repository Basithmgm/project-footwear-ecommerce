<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title><%= title || 'Footwear Admin' %></title>
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />

    <!-- Fonts -->
    <link
      href="https://fonts.googleapis.com/css?family=Montserrat:300,400,500,600,700"
      rel="stylesheet"
    />

    <!-- CSS -->
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/icomoon.css" />
    <link rel="stylesheet" href="/css/style.css" />

    <style>
      body { background:#f8f9fa; font-family:'Montserrat',sans-serif; }
      .admin-wrapper { min-height:100vh; display:flex; }
      .admin-sidebar { width:230px; background:#111; color:#fff; padding:20px 15px; }
      .admin-sidebar .brand { font-weight:700; text-transform:uppercase; letter-spacing:.08em; margin-bottom:20px; }
      .admin-sidebar ul { list-style:none; padding-left:0; margin-bottom:0; }
      .admin-sidebar li { margin-bottom:6px; }
      .admin-sidebar a { color:#ced4da; font-size:14px; display:block; padding:6px 8px; border-radius:4px; text-decoration:none; }
      .admin-sidebar a:hover,
      .admin-sidebar a.active { background:#343a40; color:#fff; }
      .admin-content { flex:1; padding:20px; }
      .admin-topbar { display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; }
      .admin-topbar-title { font-size:20px; font-weight:600; }
      .small-text { font-size:12px; color:#6c757d; }
      .card-box { background:#fff; border-radius:4px; box-shadow:0 2px 8px rgba(0,0,0,0.05); padding:15px; margin-bottom:15px; }
      .form-group label { font-size:13px; font-weight:500; }
      .form-control, .custom-select { font-size:13px; }
      @media (max-width:767.98px){
        .admin-wrapper{flex-direction:column;}
        .admin-sidebar{width:100%; display:flex; overflow-x:auto;}
        .admin-content{padding:15px;}
        .admin-topbar{flex-direction:column; align-items:flex-start;}
      }
    </style>
  </head>
  <body>
    <div class="admin-wrapper">
      <!-- SIDEBAR -->
      <aside class="admin-sidebar">
        <div class="brand">Footwear Admin</div>
        <ul>
          <li><a href="/admin/dashboard">Dashboard</a></li>
          <li><a href="/admin/orders">Orders</a></li>
          <li><a href="/admin/products">Products</a></li>
          <li><a href="/admin/users" class="active">Users</a></li>
          <li><a href="/admin/offers">Offers / Coupons</a></li>
          <li><a href="/admin/wallet">Wallet</a></li>
          <li><a href="/admin/returns">Returns</a></li>
          <li><a href="/admin/revenue-report">Revenue Report</a></li>
          <li><a href="/admin/sales-report">Sales Report</a></li>
          <li><a href="/admin/settings">Settings</a></li>
          <li><a href="/">View Store</a></li>
          <li><a href="/admin/logout">Logout</a></li>
        </ul>
      </aside>

      <!-- CONTENT -->
      <main class="admin-content">
