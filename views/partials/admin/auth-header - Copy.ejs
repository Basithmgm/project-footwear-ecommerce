<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title><%= title || 'Footwear Admin' %></title>
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />

    <!-- Fonts -->
    <link
      href="https://fonts.googleapis.com/css?family=Montserrat:300,400,500,600,700"
      rel="stylesheet"
    />

    <!-- CSS -->
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/icomoon.css" />
    <link rel="stylesheet" href="/css/style.css" />

    <style>
      body {
        background: #f8f9fa;
        font-family: "Montserrat", sans-serif;
      }
      .admin-auth-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px 15px;
      }
      .admin-auth-box {
        background: #ffffff;
        border-radius: 4px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
        padding: 30px 25px;
        max-width: 420px;
        width: 100%;
      }
      .admin-title {
        font-size: 20px;
        font-weight: 600;
        text-align: center;
        margin-bottom: 5px;
      }
      .admin-subtitle {
        font-size: 13px;
        text-align: center;
        color: #6c757d;
        margin-bottom: 20px;
      }
      .brand-text {
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-size: 13px;
        color: #343a40;
      }
      .logo-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #000;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 600;
        margin-bottom: 8px;
      }
      .form-text-sm {
        font-size: 12px;
        color: #6c757d;
      }
      .copy-footer {
        text-align: center;
        margin-top: 15px;
        font-size: 12px;
        color: #adb5bd;
      }
    </style>
  </head>
  <body>
    <div class="admin-auth-wrapper">
      <div class="admin-auth-box">
        <div class="text-center mb-2">
          <div class="logo-circle">F</div>
          <div class="brand-text">Footwear Admin</div>
        </div>
      </div>
    </div>
  </body>
</html>
